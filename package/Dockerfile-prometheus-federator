ARG GO_IMAGE=registry.suse.com/bci/golang:1.26.10
ARG BCI_VERSION=16.0
ARG FINAL_IMAGE=registry.suse.com/bci/bci-nano:${BCI_VERSION}

# Image that provides cross compilation tooling.
FROM --platform=$BUILDPLATFORM rancher/mirrored-tonistiigi-xx:1.6.1 AS xx

FROM ${GO_IMAGE} AS builder

# Allow chart version config
ARG TARGETPLATFORM
ARG TARGETARCH
ARG RANCHER_PROJECT_MONITORING=''
ARG TAG=''
ARG REPO=''

ENV RANCHER_PROJECT_MONITORING=$RANCHER_PROJECT_MONITORING TAG=$TAG REPO=$REPO

WORKDIR /usr/src/app
RUN zypper -n install git vim less file curl wget patch helm jq

COPY ./package/install-yq.sh /tmp/install-yq.sh
RUN chmod +x /tmp/install-yq.sh && /tmp/install-yq.sh && rm /tmp/install-yq.sh

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    ./scripts/build

FROM registry.suse.com/bci/bci-base:${BCI_VERSION} AS user-setup
RUN useradd -u 1000 -U -m -s /sbin/nologin prometheus

FROM ${FINAL_IMAGE} AS final
COPY --from=builder /usr/src/app/build/bin/prometheus-federator /usr/bin/
COPY --from=user-setup /etc/passwd /etc/passwd
COPY --from=user-setup /etc/group /etc/group
COPY --from=user-setup /etc/shadow /etc/shadow
COPY --from=user-setup --chown=1000:1000 /home/prometheus /home/prometheus

USER 1000

CMD ["prometheus-federator"]
