name: "[prom-fed] ci"

on:
  workflow_call:
  pull_request:
    paths-ignore:
      - 'docs/**'
      - '*.md'
      - '.gitignore'
      - 'CODEOWNERS'
      - 'LICENSE'
      - 'Makefile'
  push:
    branches:
      - main
      - release/v[0-9]+.x
      - release/v[0-9]+.[0-9]+.[0-9]+
    paths-ignore:
      - 'docs/**'
      - '*.md'
      - '.gitignore'
      - 'CODEOWNERS'
      - 'LICENSE'

jobs:
  build:
    uses: rancher/prometheus-federator/.github/workflows/ci.yaml{{AUTOMATION_CORE_REF}}
    with:
      helm-version: '{{HELM_VERSION}}'
      yq-checksum-amd64: '{{YQ_CHECKSUM_AMD64}}'
      yq-checksum-arm64: '{{YQ_CHECKSUM_ARM64}}'
