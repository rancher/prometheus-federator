{
  "extends": [
    "github>rancher/renovate-config//default#release",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "main",
    "release/v7.x",
    "release/v6.x",
    "release/v5.x",
    "release/v4.x"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "helm-values",
    "custom.regex",
    "gomod"
  ],
  "packageRules": [
    {
      "matchBaseBranches": [
        "main"
      ],
      "extends": [
        "github>rancher/renovate-config:rancher-main#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v7.x"
      ],
      "extends": [
        "github>rancher/renovate-config:rancher-2.15#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v6.x"
      ],
      "extends": [
        "github>rancher/renovate-config:rancher-2.14#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v5.x"
      ],
      "extends": [
        "github>rancher/renovate-config:rancher-2.13#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v4.x"
      ],
      "extends": [
        "github>rancher/renovate-config:rancher-2.12#release"
      ]
    },
    {
      "groupName": "GitHub Workflow Actions",
      "groupSlug": "gha-deps",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "Docker File Deps",
      "groupSlug": "docker-bumps",
      "matchManagers": [
        "dockerfile"
      ]
    },
    {
      "description": "klipper-helm tags end in -buildYYYYMMDD, which the docker versioning takes as a compatibility suffix, so a newer build was never proposed",
      "matchPackageNames": [
        "rancher/klipper-helm"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-build(?<build>\\d+)$"
    },
    {
      "description": "The images the chart ships get their own PR: a group only automerges when every update in it can, so in the all non-major group a CVE fix would wait on unrelated updates",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "charts/prometheus-federator/values.yaml"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "chart images",
      "groupSlug": "chart-images"
    },
    {
      "description": "Patch and minor updates automerge, Kubernetes minors and every major stay manual",
      "matchBaseBranches": [
        "main"
      ],
      "extends": [
        "github>rancher/renovate-config:automerge#release"
      ]
    }
  ]
}
